# Next.js Application Environment Variables
# Copy this file to .env.local and fill in your actual values.
# DO NOT commit .env.local to version control.

# Supabase configuration for authentication and database access
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Stripe configuration for payments and subscriptions
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Application URL (used for webhooks and redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ----- App Native (Expo) Environment Variables -----
# Copy this file to app-native/.env as well for the mobile app, or create a symlink
EXPO_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
EXPO_PUBLIC_API_URL="http://localhost:3000"
